# Copy to .env for local builds. Values here are loaded into process.env by
# scripts/load-env.mjs (imported by astro.config.mjs and scripts/sync-docs.mjs)
# - a variable already set in the shell, or passed to `docker build` as a
# --build-arg, always wins over this file. .env is gitignored and dockerignored;
# in CI/production these are repo variables turned into Docker build args, not
# a file.

# Canonical site URL — baked into sitemap / canonical / OG tags at build
# time. Defaults to production; the dev image can override with
# dev.docs.openlinker.io.
SITE_URL=https://docs.openlinker.io

# Branch of openlinker-project/openlinker that scripts/sync-docs.mjs pulls
# content from at build time. Defaults to main.
DOCS_SOURCE_REF=

# Optional, LOCAL BUILD only: GitHub token to raise the API rate limit for
# scripts/sync-docs.mjs. Public reads work without it (60/hour per IP).
GITHUB_TOKEN=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Only emitted when the
# configured SITE_URL above resolves to the docs.openlinker.io host - note
# that is a BUILD-TIME check on SITE_URL, not on the host actually serving
# the page, so a production-built image previewed on localhost still carries
# GA. Analytics run in basic consent mode: nothing is loaded from Google
# until the visitor accepts the banner (see src/components/Footer.astro).
# A malformed value fails the build. Leave empty locally / in dev.
PUBLIC_GA_MEASUREMENT_ID=
