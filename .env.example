# Canonical site URL — baked into sitemap / canonical / OG tags at build
# time. Defaults to production; the dev image can override with
# dev.docs.openlinker.io.
SITE_URL=https://docs.openlinker.io

# Branch of openlinker-project/openlinker that scripts/sync-docs.mjs pulls
# content from at build time. Defaults to main.
DOCS_SOURCE_REF=

# Optional, LOCAL BUILD only: GitHub token to raise the API rate limit for
# scripts/sync-docs.mjs. Public reads work without it (60/hour per IP).
GITHUB_TOKEN=

# Google Analytics 4 measurement ID (G-XXXXXXX). Only fires on the real
# docs.openlinker.io host (see astro.config.mjs) and only after the visitor
# accepts the cookie banner (Consent Mode v2, see Footer.astro). Leave empty
# locally / in dev.
PUBLIC_GA_MEASUREMENT_ID=
