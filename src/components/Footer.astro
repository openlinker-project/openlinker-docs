---
// Override for Starlight's page footer: render the default footer (edit link,
// last-updated, pagination) and append a followed link back to the main
// marketing site. Reciprocal SEO cross-link from the docs subdomain to
// openlinker.io — see issue #4. Deliberately NOT rel="nofollow": it's our own
// property, so we want link equity to flow.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props} />

<a class="main-site-link sl-flex" href="https://openlinker.io/" title="OpenLinker — openlinker.io">
  <svg
    aria-hidden="true"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M19 12H5M12 19l-7-7 7-7" />
  </svg>
  <span>Back to openlinker.io</span>
</a>

<style>
  @layer starlight.components {
    .main-site-link {
      align-items: center;
      justify-content: center;
      gap: 0.5em;
      margin: 0 auto 1.5rem;
      font-size: var(--sl-text-xs);
      text-decoration: none;
      color: var(--sl-color-gray-3);
    }
    .main-site-link:hover {
      color: var(--sl-color-white);
    }
  }
</style>
